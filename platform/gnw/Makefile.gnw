# Standalone Game & Watch GWHB build — port repo only.
#
# Produces release/cupcake.bin (Universal Homebrew Header for proc's generic
# homebrew loader). Copy to SD: /roms/homebrew/cupcake.bin (+ cupcake_assets.dat).
# Links through gw_firmware_abi at runtime — no firmware.elf or imports file.
#
# Usage (from port root):
#   make cupcake-bin
#   make cupcake-bin CUPCAKE_TRACE_SD=1   # SD session trace log (bring-up only)
#   make cupcake-compile-check
#
# When assets/screen.jpg exists, runs tools/bundle_overlay_assets.py and embeds
# graphics in cupcake.bin; audio goes to release/cupcake_assets.dat on SD.

_GNW_MK   := $(abspath $(lastword $(MAKEFILE_LIST)))
PORT_ROOT := $(abspath $(dir $(_GNW_MK))../..)
GNW_DIR   := $(PORT_ROOT)/platform/gnw
GWHB_DIR  := $(PORT_ROOT)/platform/gwhb
BUILD_DIR   := $(PORT_ROOT)/build-gnw
RELEASE_DIR := $(PORT_ROOT)/release
TARGET_ELF  := $(BUILD_DIR)/cupcake-overlay.elf
TARGET_BIN  := $(RELEASE_DIR)/cupcake.bin
LINKER      := $(GWHB_DIR)/gwhb.ld
PATCH_TOTAL_SIZE := $(PORT_ROOT)/tools/patch_gwhb_total_size.py
SDK         := $(GNW_DIR)/sdk

ASSETS_DIR     := $(PORT_ROOT)/assets
ASSETS_SCREEN  := $(ASSETS_DIR)/screen.jpg
LICENSE_TXT    := $(ASSETS_DIR)/license.txt
RELEASE_LICENSE := $(RELEASE_DIR)/license.txt
CUPCAKE_DATA_C := $(GNW_DIR)/cupcake_data.c
CUPCAKE_DATA_H := $(GNW_DIR)/cupcake_data.h
BUNDLE_PY      := $(PORT_ROOT)/tools/bundle_overlay_assets.py
ifeq ($(wildcard C:/Python313/python.exe),C:/Python313/python.exe)
PYTHON        ?= C:/Python313/python.exe
else
PYTHON        ?= $(shell command -v python3 2>/dev/null || command -v python 2>/dev/null || echo python3)
endif

CROSS_COMPILE ?= arm-none-eabi-
CC      = $(CROSS_COMPILE)gcc
OBJCOPY = $(CROSS_COMPILE)objcopy
SIZE    = $(CROSS_COMPILE)size

MCU     = -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -mno-unaligned-access
SPECS   = -specs=nano.specs -specs=nosys.specs
BASE_CFLAGS = -std=c99 -Wall -Wextra -Os -g $(MCU) $(SPECS) \
	-ffunction-sections -fdata-sections -fno-common -nostartfiles \
	-DSTM32H7B0xx -DUSE_HAL_DRIVER -DIS_LITTLE_ENDIAN -DTARGET_GNW \
	-DCUPCAKE_GNW -DCUPCAKE_ABI -DCUPCAKE_AUDIO_ODROID

CUPCAKE_TRACE_SD ?= 0
TRACE_CFLAGS :=
TRACE_SRCS :=
ifeq ($(CUPCAKE_TRACE_SD),1)
TRACE_CFLAGS := -DCUPCAKE_TRACE_SD
TRACE_SRCS := $(GNW_DIR)/cupcake_trace.c
endif

INCLUDES = \
	-I$(GWHB_DIR) \
	-I$(GNW_DIR) \
	-I$(SDK)/Core/Inc \
	-I$(SDK)/Core/Inc/porting \
	-I$(SDK)/Core/Inc/porting/cupcake \
	-I$(SDK)/Core/Inc/retro-go \
	-I$(SDK)/odroid \
	-I$(SDK)/Drivers/CMSIS/Device/ST/STM32H7xx/Include \
	-I$(PORT_ROOT)/src \
	-I$(PORT_ROOT)/platform \
	-I$(PORT_ROOT)/platform/stb

SRCS = \
	$(PORT_ROOT)/src/cupcake_game.c \
	$(PORT_ROOT)/src/cupcake_scoreboard.c \
	$(PORT_ROOT)/src/cupcake_hiscore.c \
	$(PORT_ROOT)/src/cupcake_timer.c \
	$(PORT_ROOT)/src/cupcake_rng.c \
	$(PORT_ROOT)/src/cupcake_state.c \
	$(PORT_ROOT)/platform/host_draw.c \
	$(PORT_ROOT)/platform/host_audio.c \
	$(PORT_ROOT)/platform/host_audio_catalog.c \
	$(PORT_ROOT)/platform/cupcake_input.c \
	$(GNW_DIR)/gnw_assets.c \
	$(GNW_DIR)/abi_stubs.c \
	$(GWHB_DIR)/gwhb_header.c \
	$(GWHB_DIR)/gwhb_entry.c \
	$(GNW_DIR)/main_cupcake.c \
	$(TRACE_SRCS)

ifneq ($(wildcard $(ASSETS_SCREEN)),)
EMBED_CFLAGS := -DCUPCAKE_EMBEDDED_ASSETS
EMBED_SRCS   := $(GNW_DIR)/cupcake_data.c $(GNW_DIR)/cupcake_adpcm.c $(GNW_DIR)/cupcake_assets_dat.c
else
EMBED_CFLAGS :=
EMBED_SRCS   :=
SRCS += $(PORT_ROOT)/platform/stb/stb_image_impl.c
endif

CFLAGS  = $(BASE_CFLAGS) $(EMBED_CFLAGS) $(TRACE_CFLAGS) $(INCLUDES)
SRCS   += $(EMBED_SRCS)
OBJS    = $(addprefix $(BUILD_DIR)/,$(notdir $(SRCS:.c=.o)))
vpath %.c $(sort $(dir $(SRCS)))

ifneq ($(wildcard $(ASSETS_SCREEN)),)
$(OBJS): | $(CUPCAKE_DATA_C)
endif

LDFLAGS = $(MCU) $(SPECS) -nostdlib -T$(LINKER) -Wl,--gc-sections -lgcc

.PHONY: all clean help size compile-check bundle-assets

.DEFAULT_GOAL := all

all: $(TARGET_BIN) $(RELEASE_LICENSE)

compile-check: $(OBJS)
	@echo "Compile OK ($(words $(OBJS)) objects)."

help:
	@echo "Standalone cupcake.bin (GWHB + ABI — no firmware checkout)."
	@echo "  make cupcake-bin"
	@echo "  make cupcake-bin CUPCAKE_TRACE_SD=1  (SD debug log — off by default)"

bundle-assets: $(CUPCAKE_DATA_C)

$(BUILD_DIR) $(RELEASE_DIR):
	mkdir -p $@

$(CUPCAKE_DATA_C) $(CUPCAKE_DATA_H): $(BUNDLE_PY) $(ASSETS_SCREEN) $(ASSETS_DIR)/sprites-color.png $(PORT_ROOT)/platform/host_audio_catalog.c
	$(PYTHON) $(BUNDLE_PY) --assets $(ASSETS_DIR)

$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/cupcake_data.o: $(CUPCAKE_DATA_C) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $(CUPCAKE_DATA_C) -o $@

$(TARGET_ELF): $(OBJS) $(LINKER) | $(BUILD_DIR)
	$(CC) $(OBJS) $(LDFLAGS) -o $@
	$(SIZE) $@

$(RELEASE_LICENSE): $(LICENSE_TXT) | $(RELEASE_DIR)
	cp $< $@

$(TARGET_BIN): $(TARGET_ELF) | $(RELEASE_DIR)
	$(OBJCOPY) -O binary -j .gwhb_header -j .gwhb_entry -j .gwhb_load $< $@
	$(PYTHON) $(PATCH_TOTAL_SIZE) $@
	@echo "Built $@ ($(shell wc -c < $@ | tr -d ' ') bytes) — copy to /roms/homebrew/cupcake.bin"
	@echo "Also copy release/cupcake_assets.dat to /roms/homebrew/cupcake_assets.dat"
	@echo "license.txt copied to release/ (include when redistributing builds)"

size: $(TARGET_ELF)
	$(SIZE) $(TARGET_ELF)
	@echo "GWHB image (max ~724 KiB RAM_EMU slot; header+entry+load in .bin, BSS excluded)"

clean:
	rm -rf $(BUILD_DIR)
	rm -f $(CUPCAKE_DATA_C) $(CUPCAKE_DATA_H)
