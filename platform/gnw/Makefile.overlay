# Build cupcake.bin — standalone (see Makefile.gnw).
#
# This file is a thin alias. You do NOT need the firmware source tree if
# platform/gnw/firmware_imports.ld is present (committed for releases).

PORT_ROOT := $(abspath ../..)

.PHONY: all overlay-bin clean help

all: overlay-bin

help:
	@$(MAKE) -f $(PORT_ROOT)/platform/gnw/Makefile.gnw help

overlay-bin:
	@$(MAKE) -f $(PORT_ROOT)/platform/gnw/Makefile.gnw

clean:
	@$(MAKE) -f $(PORT_ROOT)/platform/gnw/Makefile.gnw clean
